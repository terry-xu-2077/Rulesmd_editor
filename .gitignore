# Python local environment / caches
.venv/
__pycache__/
*.py[cod]
*.egg-info/
.pytest_cache/
.ruff_cache/

# Portable build/release output
/build/
/release/

# Frontend local dependencies / build output
frontend/node_modules/
frontend/dist/
frontend/.vite/
frontend/package-lock.json

# Tauri / Rust local build output
frontend/src-tauri/target/
frontend/src-tauri/icons/

# Runtime-downloaded legacy UI assets
frontend/public/legacy/

# Runtime-generated rules resources.
# The two curated schemas below are source-controlled on purpose.
src/rulesmd_editor/resources/legacy/
src/rulesmd_editor/resources/generated/*
!src/rulesmd_editor/resources/generated/control_schema.json
!src/rulesmd_editor/resources/generated/ares_schema.json

# User-editable portable data. These are created at runtime inside resources and must
# never be committed as bundled metadata, otherwise git pull/update could overwrite them.
src/rulesmd_editor/resources/app-config.json
src/rulesmd_editor/resources/user-descriptions.json
src/rulesmd_editor/resources/user-icons/

# Local editor / OS noise
.vscode/
.idea/
.DS_Store
Thumbs.db
*.log
